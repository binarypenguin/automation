{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "Ansible Automation",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "containerUser": "root",
  "remoteUser": "root",
  "securityOpt": [
    "seccomp=unconfined"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "redhat.ansible",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "ansible.python.interpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
